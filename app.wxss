/* app.wxss —— 仅放置全局重置与通用原子类，页面级样式一律写在各自的 .wxss 中，避免污染分包 */

page {
  background-color: #f7f7f7;
  color: #333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  box-sizing: border-box;
}

view,
text,
image,
button {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 主题色文字 / 价格 */
.text-primary {
  color: #07c160;
}

.price {
  color: #e64340;
  font-weight: 600;
}

/* 空态与加载态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

/* 底部安全区占位 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
