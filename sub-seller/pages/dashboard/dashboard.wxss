/* sub-seller/pages/dashboard/dashboard.wxss */
.page {
  padding: 24rpx;
}

/* 指标卡片：两列 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.stat-value.warn {
  color: #ff976a;
}

.stat-value.primary {
  color: #07c160;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

/* 菜单 */
.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 100rpx;
  font-size: 30rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.menu-item:last-child {
  border-bottom: none;
}

/*
  整行可点击的关键：
  flex: 1 让左侧文字节点占满行内剩余宽度（行高由 line-height 撑满），
  原先 <text> 只有文字那么宽，行内空白区落在行容器上，点击容易点不中。
*/
.menu-label {
  flex: 1;
  line-height: 100rpx;
}

/* 按住反馈：让「这一行被点到了」有可见的即时响应，便于自测点击区域 */
.menu-item-hover {
  background: #f2f2f2;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #fff;
  color: #666;
}
