/* sub-seller/pages/dashboard/dashboard.wxss */
.page {
  padding: 24rpx;
}

/* 指标卡片：两列 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.stat-value.warn {
  color: #ff976a;
}

.stat-value.primary {
  color: #07c160;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

/* 菜单 */
.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100rpx;
  font-size: 30rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #fff;
  color: #666;
}
