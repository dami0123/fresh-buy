/* sub-seller/pages/product-manage/product-manage.wxss */
.page {
  padding: 24rpx;
}

/* 顶部工具栏：左标题右新增按钮 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.toolbar-title {
  font-size: 28rpx;
  color: #999;
}

.btn-add {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.4;
}

.btn-add-hover {
  opacity: 0.8;
}

.product-item {
  display: flex;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.main {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  line-height: 1.4;
}

.meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.meta .price {
  font-size: 30rpx;
  margin-right: 20rpx;
}

.stock {
  margin-right: 20rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-on {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.tag-off {
  background: #f2f2f2;
  color: #999;
}

/* 操作按钮：三个按钮一行放不下时换行，不挤压封面 */
.ops {
  margin-top: auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.op {
  padding: 8rpx 24rpx;
  margin-left: 16rpx;
  border: 2rpx solid #ddd;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
}

.op.primary {
  border-color: #07c160;
  color: #07c160;
}
