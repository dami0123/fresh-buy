/* sub-seller/pages/order-manage/order-manage.wxss */
.page {
  padding: 0 24rpx 40rpx;
}

/* 状态筛选 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 0;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #07c160;
  font-weight: 600;
  box-shadow: inset 0 -4rpx 0 #07c160;
}

/* 订单卡片 */
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-warn {
  background: rgba(255, 151, 106, 0.12);
  color: #ff976a;
}

.status-primary {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.status-done {
  background: #f2f2f2;
  color: #999;
}

.order-items {
  padding: 20rpx 0;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 1.8;
}

.goods-name {
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-count {
  color: #999;
  margin-left: 20rpx;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  padding-top: 16rpx;
  border-top: 2rpx solid #f2f2f2;
}

.order-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 44rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  margin: 0;
  background: #07c160;
  color: #fff;
}
