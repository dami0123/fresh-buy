/* sub-seller/pages/order-manage/order-manage.wxss */
.page {
  padding: 0 24rpx 40rpx;
}

/*
  状态筛选用 scroll-view 横向滚动：6 个 tab（含「售后」）平分屏宽会把
  「待确认发货」这类 5 字文案挤到换行，滚动布局下每个 tab 按内容宽度自适应。
  scroll-x 生效的两个必要条件：容器 white-space: nowrap + 子项 display: inline-block。
*/
.tabs {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 0;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #07c160;
  font-weight: 600;
  box-shadow: inset 0 -4rpx 0 #07c160;
}

/* 订单卡片 */
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-warn {
  background: rgba(255, 151, 106, 0.12);
  color: #ff976a;
}

.status-primary {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.status-done {
  background: #f2f2f2;
  color: #999;
}

/* 售后中 / 已关闭：对应 ORDER_STATUS_THEME 里的 danger / muted */
.status-danger {
  background: rgba(230, 67, 64, 0.1);
  color: #e64340;
}

.status-muted {
  background: #f2f2f2;
  color: #bbb;
}

.order-items {
  padding: 20rpx 0;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 1.8;
}

.goods-name {
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-count {
  color: #999;
  margin-left: 20rpx;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  padding-top: 16rpx;
  border-top: 2rpx solid #f2f2f2;
}

/* 买家驳回发货照片的原因提示 */
.reject-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(230, 67, 64, 0.08);
  color: #e64340;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 售后信息块（只读） */
.aftersale {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fafafa;
}

.aftersale-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.aftersale-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.8;
}

.aftersale-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #999;
}

.aftersale-value {
  flex: 1;
  color: #333;
}

.liable-yes {
  color: #e64340;
  font-weight: 600;
}

.liable-no {
  color: #07c160;
  font-weight: 600;
}

.liable-pending {
  color: #ff976a;
}

.order-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.btn-ship {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 44rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  background: #07c160;
  color: #fff;
}

.btn-ship-hover {
  opacity: 0.8;
}
