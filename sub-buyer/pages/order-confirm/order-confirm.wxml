<!-- sub-buyer/pages/order-confirm/order-confirm.wxml —— 确认下单 -->
<view class="page">

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="empty" wx:elif="{{error}}">{{error}}</view>

  <block wx:else>

    <!-- ==================== 收货地址 ====================
         地址是「快照式」录入：提交时把这里的内容整体复制进 orders.address，
         因此每一项都可手改，微信地址与粘贴只负责预填，不做锁定。 -->
    <view class="card">
      <view class="card-title">
        <text>收货地址</text>
        <view class="card-title-ops">
          <text class="link" bindtap="onPasteAddress">粘贴地址</text>
          <text class="link" bindtap="onChooseWxAddress">微信地址</text>
        </view>
      </view>

      <view class="form-row {{errorField === 'name' ? 'is-error' : ''}}">
        <text class="form-label">收货人</text>
        <input
          class="form-input"
          value="{{address.name}}"
          data-field="name"
          bindinput="onInput"
          placeholder="姓名"
          placeholder-class="is-placeholder"
          maxlength="20"
        />
      </view>

      <view class="form-row {{errorField === 'phone' ? 'is-error' : ''}}">
        <text class="form-label">手机号</text>
        <!-- 不用 type="number"：粘贴进来的地址里座机号可能带 '-'，数字键盘会吃掉它 -->
        <input
          class="form-input"
          value="{{address.phone}}"
          data-field="phone"
          bindinput="onInput"
          placeholder="手机号或座机"
          placeholder-class="is-placeholder"
          maxlength="20"
        />
      </view>

      <view class="form-row {{errorField === 'province' || errorField === 'city' || errorField === 'district' ? 'is-error' : ''}}">
        <text class="form-label">所在地区</text>
        <picker
          class="form-picker"
          mode="region"
          value="{{region}}"
          bindchange="onRegionChange"
        >
          <view class="{{regionText ? '' : 'is-placeholder'}}">{{regionText || '请选择省市区'}}</view>
        </picker>
      </view>

      <view class="form-row form-row-top {{errorField === 'detail' ? 'is-error' : ''}}">
        <text class="form-label">详细地址</text>
        <textarea
          class="form-textarea"
          value="{{address.detail}}"
          data-field="detail"
          bindinput="onInput"
          placeholder="街道、门牌号等"
          placeholder-class="is-placeholder"
          maxlength="120"
          auto-height
        />
      </view>
    </view>

    <!-- ==================== 商品清单 ==================== -->
    <view class="card">
      <view class="card-title">商品清单</view>

      <view class="goods" wx:for="{{carts}}" wx:key="_id">
        <image class="goods-cover" src="{{item.image}}" mode="aspectFill" />
        <view class="goods-main">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-meta">
            <text class="price">¥{{item.priceText}}</text>
            <text class="goods-count">×{{item.count}}</text>
          </view>
        </view>
        <text class="goods-subtotal">¥{{item.subtotalText}}</text>
      </view>
    </view>

    <view class="hint">本项目无支付环节，提交后订单直接进入「待发货」，由商家拍照发货。</view>

    <!-- ==================== 底部提交栏 ==================== -->
    <view class="bar-placeholder"></view>
    <view class="bar">
      <view class="bar-total">
        共 {{totalCount}} 件，合计 <text class="price">¥{{totalText}}</text>
      </view>
      <button class="btn btn-primary" bindtap="onSubmit" disabled="{{submitting}}">提交订单</button>
    </view>

  </block>

</view>
