/* sub-buyer/pages/detail/detail.wxss */
.page {
  padding: 0 24rpx;
}

.gallery {
  height: 560rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 24rpx 0;
}

.gallery-img {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
}

.info .price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.price-lg {
  font-size: 44rpx;
}

.stock {
  font-size: 24rpx;
  color: #999;
}

.name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.category {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 数量选择 */
.counter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
}

.counter-value {
  min-width: 88rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 底部操作栏 */
.footer-placeholder {
  height: 140rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding: 0 24rpx calc(0px + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.footer-total {
  font-size: 26rpx;
  color: #666;
}

.footer-btns {
  display: flex;
}

.btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 40rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-plain {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}
