<!-- pages/index/index.wxml —— 启动页 / 身份选择页 -->
<view class="page">

  <view class="brand">
    <view class="logo">🥬</view>
    <view class="title">FreshBuy 生鲜</view>
    <view class="subtitle">新鲜直达 · 双端一体</view>
  </view>

  <!-- 登录中 -->
  <view class="loading" wx:if="{{loading}}">正在识别身份…</view>

  <!-- 云环境异常 -->
  <view class="error-box" wx:elif="{{error}}">
    <view class="error-text">{{error}}</view>
    <button class="btn btn-primary" bindtap="login">重试</button>
  </view>

  <!-- 手动选择身份：login 成功后停留本页，由用户点击进入对应端 -->
  <view class="actions" wx:else>
    <view class="hint">当前账号身份：{{roleText}}</view>
    <button class="btn btn-primary" bindtap="onEnterBuyer">进入用户端</button>
    <button class="btn btn-plain" bindtap="onEnterSeller">进入商家端</button>
  </view>

</view>
